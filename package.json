  "private": true,
  "description": "Fly through TESS exoplanet systems in a 3D galaxy map in the browser.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
